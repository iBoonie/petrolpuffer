{
    "type": "srcds",
    "display": "Team Fortress 2 - Petrol",
    "data": {
        "ip": {
            "type": "string",
            "value": "0.0.0.0",
            "display": "IP",
            "desc": "What IP to bind the server to",
            "required": true,
            "userEdit": false
        },
        "mapname": {
            "type": "string",
            "value": "pl_badwater",
            "display": "Team Fortess 2 Map to load",
            "desc": "TF2 Map",
            "required": true,
            "userEdit": true
        },
        "maxplayers": {
            "type": "integer",
            "value": 32,
            "display": "Max Players",
            "desc": "Max players that can be in the server",
            "required": true,
            "userEdit": false
        },
        "port": {
            "type": "integer",
            "value": 27015,
            "display": "Port",
            "desc": "What port to bind the server to",
            "required": true,
            "userEdit": false
        },
        "tv_port": {
            "type": "integer",
            "value": 27025,
            "display": "SourceTV Port",
            "desc": "What port to bind the SourceTV server to",
            "required": false,
            "userEdit": false
        }
    },
    "install": [
        {
            "type": "command",
            "commands": [
                "steamcmd +login anonymous +quit",
                "steamcmd +force_install_dir /pufferpanel +login anonymous +app_update 232250 validate +quit"
            ]
        },
        {
            "type": "command",
            "commands": [
                "chmod +x srcds_run srcds_run_64"
            ]
        },
        {
            "type": "command",
            "commands": [
                "mkdir -p /pufferpanel/.steam",
                "ln -sfn /pufferpanel/.local/share/Steam/steamcmd/linux32 /pufferpanel/.steam/sdk32",
                "ln -sfn /pufferpanel/.local/share/Steam/steamcmd/linux64 /pufferpanel/.steam/sdk64"
            ]
        }
    ],
    "run": {
        "command": "./srcds_run -game tf -console -strictportbind -norestart -autoupdate -steam_dir /pufferpanel/.local/share/Steam/steamcmd -steamcmd_script /pufferpanel/.steam/autoupdate.txt +ip ${ip} +port ${port} +tv_port ${tv_port} +maxplayers ${maxplayers} +map ${mapname}",
        "stop": "exit",
        "pre": [
            {
                "type": "writefile",
                "target": ".steam/autoupdate.txt",
                "text": "@ShutdownOnFailedCommand 1\n@NoPromptForPassword 1\nforce_install_dir /pufferpanel\nlogin anonymous\napp_update 232250\nquit\n"
            }
        ],
        "stdin": {
            "type": "stdin"
        },
        "autostart": false,
        "autorecover": false,
        "autorestart": false
    },
    "environment": {
        "type": "docker",
        "image": "steamcmd-tf2:latest",
        "portBindings": [
            "0.0.0.0:${port}:${port}/udp",
            "0.0.0.0:${tv_port}:${tv_port}/udp"
        ]
    },
    "supportedEnvironments": [
        {
            "type": "docker",
            "image": "steamcmd-tf2:latest",
            "portBindings": [
                "0.0.0.0:${port}:${port}/udp",
                "0.0.0.0:${tv_port}:${tv_port}/udp"
            ]
        }
    ],
    "requirements": {
        "os": "linux",
        "arch": "amd64"
    },
    "name": "Petrol"
}